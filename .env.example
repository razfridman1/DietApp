# Supabase (https://supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Reports — email delivery (Resend preferred). Sign up: https://resend.com
# RESEND_API_KEY=re_...
# REPORT_FROM_EMAIL="תזונה וכושר AI <noreply@yourdomain.com>"
#
# Optional SMTP fallback (only used if RESEND_API_KEY is not set).
# Requires `npm i nodemailer`.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=secret
# SMTP_FROM="תזונה וכושר AI <noreply@yourdomain.com>"
#
# Optional: override the Hebrew font URLs used by the PDF generator
# REPORT_FONT_REGULAR_URL=https://example.com/Heebo-Regular.ttf
# REPORT_FONT_BOLD_URL=https://example.com/Heebo-Bold.ttf
